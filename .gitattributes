# GitHub Actions runners are Linux. Force LF for every text file so bash run:
# blocks and Python sources never carry trailing CR from a Windows checkout.
* text=auto eol=lf

*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
